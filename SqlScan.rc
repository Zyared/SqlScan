#include "resource.h"
#include "afxres.h"

IDD_SQLSCAN_DIALOG DIALOGEX 0, 0, 320, 240
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "SqlScan"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT "Input:", IDC_STATIC_IN, 7, 7, 300, 9
    EDITTEXT IDC_EDIT_INPUT, 7, 18, 306, 80, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON "Check", IDC_BTN_CHECK, 7, 103, 70, 14
    PUSHBUTTON "Load...", IDC_BTN_LOAD, 82, 103, 95, 14
    PUSHBUTTON "Save...", IDC_BTN_SAVE, 182, 103, 95, 14
    LTEXT "Output:", IDC_STATIC_OUT, 7, 124, 300, 9
    CONTROL "", IDC_EDIT_OUTPUT, "RichEdit20W", ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER | WS_TABSTOP, 7, 135, 306, 98
END
