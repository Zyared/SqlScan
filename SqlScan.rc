#pragma code_page(65001)
#include "resource.h"
#include "afxres.h"
#include <commctrl.h>

IDR_SCHEMA RCDATA "db\\schema.sql"
IDR_UPGRADE RCDATA "db\\upgrade_2.sql"
IDR_MENU MENU
BEGIN
    POPUP "Приложение"
    BEGIN
        MENUITEM "Настройки базы данных…", ID_CONNECT
        MENUITEM "Автономный режим", ID_OFFLINE
        MENUITEM SEPARATOR
        MENUITEM "Выход", ID_QUIT
    END
    MENUITEM "О программе", ID_ABOUT_SCAN
END

IDD_SQLSCAN_DIALOG DIALOGEX 0,0,570,365
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "SqlScan 2.0"
MENU IDR_MENU
FONT 9,"Segoe UI"
BEGIN
    CONTROL "",IDC_TABS,"SysTabControl32",WS_TABSTOP,7,5,556,16
    LTEXT "Текст для проверки",IDC_STATIC_IN,8,30,520,12
    EDITTEXT IDC_EDIT_INPUT,8,45,550,90,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON "Проверить",IDC_BTN_CHECK,8,140,70,18
    PUSHBUTTON "Открыть файл…",IDC_BTN_LOAD,82,140,90,18
    PUSHBUTTON "Экспорт отчёта…",IDC_BTN_SAVE,176,140,95,18
    PUSHBUTTON "Ручной ввод",IDC_NEW_INPUT,275,140,90,18
    LTEXT "Результат",IDC_STATIC_OUT,8,165,500,12
    CONTROL "",IDC_EDIT_OUTPUT,"RichEdit20W",ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER | WS_TABSTOP,8,180,550,142
    CONTROL "",IDC_TABLE,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER,8,45,550,200
    PUSHBUTTON "",IDC_ACTION1,8,25,80,18
    PUSHBUTTON "",IDC_ACTION2,92,25,80,18
    PUSHBUTTON "",IDC_ACTION3,176,25,80,18
    PUSHBUTTON "",IDC_ACTION4,260,25,80,18
    PUSHBUTTON "Назад",IDC_PAGE_PREV,8,300,65,18
    PUSHBUTTON "Далее",IDC_PAGE_NEXT,78,300,65,18
    LTEXT "",IDC_PAGE_LABEL,150,302,260,16
    CONTROL "",IDC_CHART,"Static",SS_NOTIFY | WS_BORDER,8,220,550,80
    LTEXT "",IDC_STATUS,8,340,550,18
END
IDD_CONNECT DIALOGEX 0,0,350,102
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Подключение к PostgreSQL"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Строка ODBC (например, DSN=SqlScan;UID=sqlscan_app;PWD=…)",-1,8,8,332,14
    EDITTEXT IDC_CONN,8,28,332,16,ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON "Проверить соединение",IDC_TEST,8,69,108,19
    DEFPUSHBUTTON "Подключить",IDOK,193,69,75,19
    PUSHBUTTON "Отмена",IDCANCEL,273,69,67,19
END
IDD_RULE DIALOGEX 0,0,305,154
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Сигнатура"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Шаблон",-1,8,8,75,12
    EDITTEXT IDC_PATTERN,90,6,202,16,ES_AUTOHSCROLL
    LTEXT "Категория",-1,8,33,75,12
    COMBOBOX IDC_CATEGORY,90,30,202,105,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Вес (1–5)",-1,8,57,75,12
    EDITTEXT IDC_WEIGHT,90,54,45,16,ES_NUMBER
    CONTROL "Высокий риск",IDC_HIGH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,82,120,15
    CONTROL "Включена",IDC_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,145,82,100,15
    DEFPUSHBUTTON "Сохранить",IDOK,143,122,75,19
    PUSHBUTTON "Отмена",IDCANCEL,225,122,67,19
END
IDD_FILTER DIALOGEX 0,0,316,184
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Фильтры журнала"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Название источника",-1,8,10,110,12
    EDITTEXT IDC_SEARCH,126,7,180,16,ES_AUTOHSCROLL
    LTEXT "С даты (ГГГГ-ММ-ДД)",-1,8,35,115,12
    EDITTEXT IDC_FROM,126,32,180,16,ES_AUTOHSCROLL
    LTEXT "По дату включительно",-1,8,59,115,12
    EDITTEXT IDC_UNTIL,126,56,180,16,ES_AUTOHSCROLL
    LTEXT "Вердикт",-1,8,82,100,12
    COMBOBOX IDC_VERDICT,126,79,180,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Источник",-1,8,105,100,12
    COMBOBOX IDC_SOURCE,126,102,180,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Минимальный балл",-1,8,129,105,12
    EDITTEXT IDC_MIN_SCORE,126,126,70,16,ES_NUMBER
    DEFPUSHBUTTON "Применить",IDOK,155,155,78,19
    PUSHBUTTON "Отмена",IDCANCEL,239,155,67,19
END
IDD_DETAIL DIALOGEX 0,0,480,268
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Сохранённая проверка"
FONT 9,"Segoe UI"
BEGIN
    EDITTEXT IDC_DETAIL,8,7,462,219,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Экспорт…",IDC_EXPORT,8,240,70,19
    DEFPUSHBUTTON "Закрыть",IDOK,401,240,69,19
END
